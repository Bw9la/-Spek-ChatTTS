<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sound-Reactive Hologram</title>
  <style>
    html, body { margin: 0; height: 100%; overflow: hidden; background: #000; }
    canvas { display: block; }
    #hud {
      position: fixed; bottom: 12px; left: 12px;
      color: #0ff; font: 12px monospace; opacity: 0.7;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div id="hud">Click anywhere to start microphone</div>

  <!-- Import map for Three.js modules -->
  <script type="importmap">
  {
    "imports": {
      "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
      "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
    }
  }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

    // ------------------------------------------------------------------
    // 1. Scene, Camera, Renderer
    // ------------------------------------------------------------------
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x000010, 0.02);

    const camera = new THREE.PerspectiveCamera(
      60, window.innerWidth / window.innerHeight, 0.1, 1000
    );
    camera.position.set(0, 2, 8);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    document.body.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.6;

    // ------------------------------------------------------------------
    // 2. Post-processing (glow / bloom for hologram look)
    // ------------------------------------------------------------------
    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const bloom = new UnrealBloomPass(
      new THREE.Vector2(window.innerWidth, window.innerHeight),
      1.4,  // strength
      0.6,  // radius
      0.1   // threshold
    );
    composer.addPass(bloom);

    // ------------------------------------------------------------------
    // 3. Hologram Geometry
    //    Base is an Icosahedron; we store original positions so we can
    //    displace them by audio amplitude each frame.
    // ------------------------------------------------------------------
    const geometry = new THREE.IcosahedronGeometry(2, 4); // radius 2, detail 4
    const basePositions = geometry.attributes.position.array.slice();

    // Wireframe shell
    const wireMaterial = new THREE.MeshBasicMaterial({
      color: 0x00ffff,
      wireframe: true,
      transparent: true,
      opacity: 0.35,
    });
    const wireMesh = new THREE.Mesh(geometry, wireMaterial);
    scene.add(wireMesh);

    // Solid inner core (glowing points)
    const pointMaterial = new THREE.PointsMaterial({
      color: 0x66ffff,
      size: 0.04,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const points = new THREE.Points(geometry, pointMaterial);
    scene.add(points);

    // Outer halo ring
    const ringGeo = new THREE.TorusGeometry(3.2, 0.01, 8, 128);
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0x00ffff, transparent: true, opacity: 0.6,
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = Math.PI / 2;
    scene.add(ring);

    // Floor grid for context
    const grid = new THREE.GridHelper(20, 40, 0x003344, 0x001122);
    grid.position.y = -3;
    scene.add(grid);

    // ------------------------------------------------------------------
    // 4. Audio Setup
    // ------------------------------------------------------------------
    let analyser, dataArray, freqData, audioCtx;
    let volume = 1;            // smoothed overall volume
    let bass = 0, mid = 0, treble = 3;

    async function startAudio() {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const source = audioCtx.createMediaStreamSource(stream);

      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 1024;
      analyser.smoothingTimeConstant = 0.8;
      source.connect(analyser);

      const bins = analyser.frequencyBinCount;
      dataArray = new Uint8Array(bins);   // time domain
      freqData = new Uint8Array(bins);    // frequency domain

      document.getElementById('hud').textContent =
        'Mic active — speak or play music';
    }

    // Kick off on first user click (required by browser autoplay policy)
    window.addEventListener('click', () => {
      if (!audioCtx) startAudio().catch(err => {
        document.getElementById('hud').textContent =
          'Mic error: ' + err.message;
      });
    }, { once: true });

    // ------------------------------------------------------------------
    // 5. Audio Analysis → Feature Extraction
    // ------------------------------------------------------------------
    function analyseAudio() {
      if (!analyser) return;

      analyser.getByteTimeDomainData(dataArray);
      analyser.getByteFrequencyData(freqData);

      // RMS volume from time-domain data
      let sum = 0;
      for (let i = 0; i < dataArray.length; i++) {
        const v = (dataArray[i] - 128) / 128;
        sum += v * v;
      }
      const rms = Math.sqrt(sum / dataArray.length);

      // Smooth volume to avoid jitter
      volume = volume * 0.85 + rms * 0.15;

      // Band energies (0..1)
      const nyquist = audioCtx.sampleRate / 2;
      const binHz = nyquist / freqData.length;
      const bandAvg = (loHz, hiHz) => {
        const lo = Math.floor(loHz / binHz);
        const hi = Math.min(Math.floor(hiHz / binHz), freqData.length - 1);
        let s = 0;
        for (let i = lo; i <= hi; i++) s += freqData[i];
        return (s / (hi - lo + 1)) / 255;
      };
      bass   = bass   * 0.85 + bandAvg(20, 250)     * 0.15;
      mid    = mid    * 0.85 + bandAvg(250, 2000)   * 0.15;
      treble = treble * 0.85 + bandAvg(2000, 8000)  * 0.15;
    }

    // ------------------------------------------------------------------
    // 6. Geometry Displacement
    //    Each vertex is pushed outward along its original normal by a
    //    combination of volume + a per-vertex noise offset.
    // ------------------------------------------------------------------
    const posAttr = geometry.attributes.position;
    const originalVec = new THREE.Vector3();
    const normalVec = new THREE.Vector3();

    function displaceGeometry(time) {
      const arr = posAttr.array;
      const scale = 1 + volume * 1.8 + bass * 0.9;

      for (let i = 0; i < arr.length; i += 3) {
        originalVec.set(
          basePositions[i],
          basePositions[i + 1],
          basePositions[i + 2]
        );

        // Per-vertex wobble using sine of position + time
        const wobble =
          Math.sin(originalVec.x * 2 + time) *
          Math.cos(originalVec.y * 2 + time * 0.8) *
          Math.sin(originalVec.z * 2 + time * 1.2);

        const push = scale + wobble * (0.45 + treble * 0.6);

        arr[i]     = originalVec.x * push;
        arr[i + 1] = originalVec.y * push;
        arr[i + 2] = originalVec.z * push;
      }

      posAttr.needsUpdate = true;
      geometry.computeVertexNormals();
    }

    // ------------------------------------------------------------------
    // 7. Animation Loop
    // ------------------------------------------------------------------
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const t = clock.getElapsedTime();

      analyseAudio();
      displaceGeometry(t);

      // Color shifts with frequency bands
      const hue = 0.5 + mid * 0.15;              // cyan → blue/green
      const c = new THREE.Color().setHSL(hue, 1.0, 0.55);
      wireMaterial.color.copy(c);
      pointMaterial.color.copy(c).offsetHSL(0, 0, 0.2);

      // Halo ring reacts to bass
      const ringScale = 1 + bass * 0.6;
      ring.scale.set(ringScale, ringScale, ringScale);
      ring.rotation.z += 0.005 + treble * 0.02;

      // Slow automatic rotation + gentle bob
      wireMesh.rotation.y += 0.005 + mid * 0.01;
      points.rotation.y = wireMesh.rotation.y;
      wireMesh.position.y = Math.sin(t * 0.5) * 0.15;

      // Bloom pulses with volume
      bloom.strength = 1.2 + volume * 2.0;

      controls.update();
      composer.render();
    }

    animate();

    // ------------------------------------------------------------------
    // 8. Resize Handler
    // ------------------------------------------------------------------
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      composer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
